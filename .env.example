# Kopiraj ovaj fajl u .env i upiši svoje vrijednosti. Fajl .env se NE šalje na GitHub.

# Ključ za The Odds API (https://the-odds-api.com) — potreban samo za povlačenje dnevne ponude
ODDS_API_KEY=

# Ključ za Claude API (https://console.anthropic.com → API keys) — potreban samo za AI izvještaj
# (10 najsigurnijih opklada dnevno). API se plaća po potrošnji, odvojeno od pretplate na Claude aplikaciju.
ANTHROPIC_API_KEY=

# Claude model za AI izvještaj (podrazumijevano claude-opus-5-5; jeftiniji: claude-sonnet-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# NBA sezona u formatu YYYY-YY. Ako je prazno: uzima se sezona iz postojećih fajlova u data/,
# a ako ni njih nema — računa se iz današnjeg datuma (od oktobra počinje nova sezona).
# NBA_SEASON=2026-27

# Folder sa CSV podacima i folder za istoriju analiza (podrazumijevano: data/ i history/ u projektu)
# NBA_DATA_DIR=/putanja/do/data
# NBA_HISTORY_DIR=/putanja/do/history

# Redoslijed kladionica pri izboru linije (prva koja ima ponudu)
# ODDS_BOOKMAKERS=pinnacle,bet365,fanduel,draftkings,betmgm,betrivers,betonlineag,bovada

# Regije kladionica za The Odds API (svaka košta 1 zahtjev po meču). Podrazumijevano us,eu; "uk" nema NBA player props.
# ODDS_REGIONS=us,eu
