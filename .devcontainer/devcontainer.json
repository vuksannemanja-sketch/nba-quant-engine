{
  "name": "NBA Quant Engine (Python 3.11)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt && echo 'Zavisnosti instalirane'",
  "postAttachCommand": {
    "server": "python -m nba_engine ui --headless"
  },
  "portsAttributes": {
    "8501": {
      "label": "NBA Quant Engine",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
